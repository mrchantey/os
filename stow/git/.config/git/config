# See https://git-scm.com/docs/git-config

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[init]
	defaultBranch = main     # `main` is the default on GitHub and Tangled alike
[pull]
	rebase = true 			 # Rebase (instead of merge) on pull
[push]
	autoSetupRemote = true   # Automatically set upstream branch on push
[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	mnemonicPrefix = true    # More intuitive refs in diff output
[commit]
	verbose = true           # Include diff comment in commit message template
[column]
	ui = auto 			     # Output in columns when possible
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[rerere]
	enabled = true           # Record and reuse conflict resolutions
	# autoupdate stays off: an auto-applied resolution is staged with no conflict
	# left in the tree, so a wrong one silently re-applies itself on every future
	# merge. Off, git still replays it but leaves it unstaged for review.
	autoupdate = false       # Stage replayed resolutions by hand
[user]
	name = Peter Hayman
	email = peteyhayman@gmail.com
# Authenticate https:// pushes and clones of private repos through `gh auth`,
# so nothing has to keep a token on disk. The empty first `helper =` is the
# documented way to clear any helper inherited from a lower-priority config.
#
# `gh` is deliberately BARE, not the absolute path that `gh auth setup-git`
# writes. That command bakes in wherever it found gh on the machine of the day,
# and under omarchy quattro that answer moves: gh is no longer pacman's
# /usr/bin/gh but an `omarchy-mise-install` wrapper in ~/.local/bin, fronted by
# ~/.local/share/mise/shims. The stale /usr/bin/gh path silently failed on the
# 2026-09-10 Precision rebuild -- git fell back to prompting for a username and
# `just pull-repos` could not clone the private beet-draft or beetmash.
#
# A credential helper's stdout is a data channel that git parses, which is
# normally a reason NOT to front a tool with a mise wrapper (see AGENTS.md).
# It is safe here: omarchy-mise-install now writes `mise use -g --quiet`, and
# both the shim and the wrapper were verified to emit nothing but the four
# credential lines.
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
