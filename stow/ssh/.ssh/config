## SSH client config -- shared across devices.
## Only public information lives here. Private keys are generated per device by
## `just setup-ssh-key <host>` and stay in ~/.ssh, never in this repo.

Host *
	# load a key into the agent the first time it is used, so a passphrase is
	# typed once per login rather than once per push
	AddKeysToAgent yes

# tangled -- git over SSH, no shell. The SSH *user* is the atproto handle, which
# is how a knot looks up the keys published to that account; the *path* is the
# repo's own DID, with no repo name after it. Repos can live on any knot, hence
# the wildcard. Remotes then look like: knot1.tangled.sh:did:plc:<repoDID>
Host tangled.org *.tangled.sh
	User mrchantey.bsky.social
 	IdentityFile ~/.ssh/id_ed25519_tangled
	# only offer that key, don't walk every key in ~/.ssh
	IdentitiesOnly yes
